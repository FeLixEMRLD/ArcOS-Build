<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Status bar height to clear the center punch-hole camera -->
    <dimen name="status_bar_height_portrait">38dp</dimen>
    <dimen name="status_bar_height_landscape">28dp</dimen>
    <dimen name="quick_qs_offset_height">48dp</dimen>

    <!-- Rounded Corners Padding for emerald -->
    <dimen name="rounded_corner_radius">32dp</dimen>
    <dimen name="rounded_corner_content_padding">16dp</dimen>
    <dimen name="status_bar_padding_start">8dp</dimen>
    <dimen name="status_bar_padding_end">8dp</dimen>

    <!-- Center Punch-Hole Cutout SVG Path -->
    <string name="config_mainBuiltInDisplayCutout" translatable="false">M 0,0 H -36 V 105 H 36 V 0 H 0 Z</string>
    <bool name="config_fillMainBuiltInDisplayCutout">true</bool>

    <!-- Enable Automatic Brightness & 120Hz Smooth Display -->
    <bool name="config_automatic_brightness_available">true</bool>
    <integer name="config_defaultPeakRefreshRate">120</integer>
    <integer name="config_defaultRefreshRate">120</integer>
</resources>
